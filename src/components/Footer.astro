---
import type { Translations } from '../i18n/types';

interface Props {
  t: Translations;
}

const { t } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <p>© {year} Elvis Wesley Vásquez. {t.footer.rights}</p>
    <p>{t.footer.builtWith}</p>
  </div>
</footer>
